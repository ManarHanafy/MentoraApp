31\u064a\u0646 \u0645\u062e\u0635\u0635\u0629.':'Meet your AI Companion. Start a chat anytime to get support, vent, and receive personalized exercise recommendations.'},{title:'ar'===P?'\u0627\u0644\u062a\u0645\u0627\u0631\u064a\u0646 \u0627\u0644\u0645\u0648\u0635\u0649 \u0628\u0647\u0627':'Recommended Exercises',text:'ar'===P?'\u0627\u0644\u062a\u0645\u0627\u0631\u064a\u0646 \u0627\u0644\u0645\u062e\u0635\u0635\u0629. \u0623\u0643\u0645\u0644 \u0627\u0644\u062a\u0645\u0627\u0631\u064a\u0646 \u0627\u0644\u0645\u0635\u0645\u0645\u0629 \u062e\u0635\u064a\u0635\u0627\u064b \u0644\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a\u0643 \u0648\u062a\u0642\u062f\u0645 \u0641\u064a \u062e\u0627\u0631\u0637\u0629 \u0627\u0644\u0637\u0631\u064a\u0642.':'Personalized Exercises. Complete exercises tailored to your needs and advance through your roadmap.'},{title:'ar'===P?'\u062f\u0641\u062a\u0631 \u064a\u0648\u0645\u064a\u0627\u062a\u0643 \u0627\u0644\u062e\u0627\u0635':'Private Journal',text:'ar'===P?'\u062f\u0641\u062a\u0631 \u064a\u0648\u0645\u064a\u0627\u062a\u0643 \u0627\u0644\u062e\u0627\u0635. \u0633\u062c\u0644 \u0623\u0641\u0643\u0627\u0631\u0643\u060c \u0648\u0639\u0628\u0631 \u0639\u0646 \u0645\u0634\u0627\u0639\u0631\u0643\u060c \u0648\u062f\u0639 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u064a\u062d\u0644\u0644 \u0623\u0646\u0645\u0627\u0637\u0643 \u0627\u0644\u0639\u0627\u0637\u0641\u064a\u0629.':'Private Journal. Record your thoughts, express your feelings, and let AI analyze your emotional patterns.'},{title:'ar'===P?'\u062a\u062d\u0644\u064a\u0644\u0627\u062a \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0646\u0641\u0633\u064a\u0629':'Your Mental Wellness Insights',text:'ar'===P?'\u062a\u062a\u0628\u0639 \u0623\u0646\u0645\u0627\u0637 \u0645\u0632\u0627\u062c\u0643\u060c \u062a\u0642\u062f\u0645 \u0627\u0644\u062a\u0645\u0627\u0631\u064a\u0646\u060c \u0648\u0627\u0644\u0627\u062a\u062c\u0627\u0647\u0627\u062a \u