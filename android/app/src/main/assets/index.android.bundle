saveSuggestedExercises:(E=(0,n.default)(function*(e){try{var t=e.filter(function(e){var t='string'==typeof e?e:e.id||e.exerciseCode||e.exercise_code||'';return!I.includes(t)}).map(function(e){if('string'==typeof e){var t=D.getExerciseDetailsByCode(e);return{id:Date.now().toString()+Math.random(),name:t.name||e.split('\n')[0].slice(0,30),description:t.description||e,exerciseType:t.exerciseType||'General',durationMinutes:void 0!==t.durationMinutes?t.durationMinutes:5,difficulty:t.difficulty||'Medium',instructions:t.instructions||e,exerciseCode:e.includes('_')?e:void 0,isActive:!0}}var n=e.exerciseCode||e.exercise_code||e.code||('string'==typeof e.id&&e.id.includes('_')?e.id:''),s=n?D.getExerciseDetailsByCode(n):{},c=e.name||e.Name||e.title||e.Title||s.name||'Mindfulness Exercise',o=e.description||e.Description||s.description||'A recommended wellness exercise designed for your current needs.',u=e.instructions||e.Instructions||s.instructions||o||'',l=e.exerciseType||e.ExerciseType||s.exerciseType||'General',f=void 0!==e.durationMinutes?e.durationMinutes:void 0!==s.durationMinutes?s.durationMinutes:5,y=e.difficulty||e.Difficulty||s.difficulty||'Medium';return{id:e.id||e.Id||Date.now().toString()+Math.random(),name:c,description:o,exerciseType:l,durationMinutes:f,difficulty:y,instructions:u,exerciseCode:n||e.exerciseCode,isActive:!0}}),n=yield D.getUserKey('@suggested_exercises'),o=yield c.default.getItem(n),u=o?JSON.parse(o):[],l=t.map(function(e){return Object.assign({},e,{queueId:Date.now().toString()+Math.random().toString(),suggestedAt:Date.now()})}),f=u.filter(function(e){return!l.some(function(t){return t.id==e.id||t.name==e.name})}),y=[].concat((0,s.default)(l),(0,s.default)(f));yield c.default.setItem(n,JSON.stringify(y))}catch(e){console.error('Failed to save suggested exercises:',e)}}),function(e){return E.apply(this,arguments)}),removeSuggestedExercise:(C=(0,n.default)(function*(e){try{var t=yield D.getUserKey('@suggested_exercises'),n=yield c.default.getItem(t);if(n){var s=JSON.parse(n);s=s.filter(function(t){return t.queueId!=e&&t.id!=e}),yield c.default.setItem(t,JSON.stringify(s))}}catch(e){}}),function(e){return C.apply(this,arguments)}),getSuggestedExercises:(_=(0,n.default)(function*(){try{var e=yield D.getUserKey('@suggested_exercises'),t=yield c.default.getItem(e);return t?JSON.parse(t).filter(function(e){return!I.includes(e.id||e.exerciseCode)}):[]}catch(e){return[]}}),function(){return _.apply(this,arguments)}),getCompletedExercises:(h=(0,n.default)(function*(){try{var e=yield D.getUserKey('@completed_exercises'),t=yield c.default.getItem(e);return t?JSON.parse(t).filter(function(e){return!I.includes(e.id||e.exerciseCode)}):[]}catch(e){return[]}}),function(){return h.apply(this,arguments)}),saveCompletedExercise:(v=(0,n.default)(function*(e){try{if(I.includes(String(e.id))||I.includes(String(e.exerciseCode)))return;var t=yield D.getUserKey('@completed_exercises'),n=(yield D.getCompletedExercises()).filter(function(t){return t.id!==e.id}),o=[e].concat((0,s.default)(n));yield c.default.setItem(t,JSON.stringify(o))}catch(e){console.error(e)}}),function(e){return v.apply(this,arguments)}),clearSuggestedExercises:(x=(0,n.default)(function*(){try{var e=yield D.getUserKey('@suggested_exercises');yield c.default.removeItem(e)}catch(e){console.error('Failed to clear suggested exercises:',e)}}),function(){return x.apply(this,arguments)}),clearCache:function(){}}},518,[17,358,25,508,515,519,520,521,516]);
__d(function(e,t,i,o,a,n,s){a.exports=[{id:"Reality_Check_Journal_Weekly",name:"Weekly Reality Check Journal",parameters:["CDT"],goals:["Maintain clear thinking","Catch distortions early"],score_ranges:{CDT:"0-2"},duration_minutes:10,frequency:"Once per week",description:"A maintenance exercise for healthy thinkers. A weekly self-check to spot any creeping cognitive distortions before they grow into patterns.",research_basis:"CBT metacognition maintenance protocols",tutorial_steps:["Once a week, write about one situation that bothered you.","Ask: Was my thinking accurate? Did I catastrophize, overgeneralize, or mind-read?","If yes: write a more balanced version.","If your thinking was accurate: note how you handled it well.","End with one thing you're proud of this week."],tips:"This is a tune-up, not a repair. Brief and light \u2014 the goal is awareness, not deep analysis.",video_url:"https://www.youtube.com/watch?v=WPPPFqsECz0",video_title:"Journaling for Cognitive Awareness (YouTube)"},{id:"Thought_Awareness_Daily",name:"Daily Thought Awareness",parameters:["CDT"],goals:["Build metacognitive awareness","Notice thinking patterns before they cause distress"],score_ranges:{CDT:"0-2"},duration_minutes:3,frequency:"Daily",description:"A brief daily awareness practice \u2014 just noticing thoughts without reacting to them. Builds the foundational skill that makes all CBT exercises more effective.",research_basis:"CBT metacognition (Wells, 2000); Mindfulness-based cognitive therapy (MBCT)",tutorial_steps:["Once a day, pause for 2-3 minutes and observe your current thoughts.","Don't judge them \u2014 just notice: What am I thinking? Is this thought helpful? Is it accurate?","You don't need to change anything. Just observe.","If you notice a distorted thought: acknowledge it ('There's that all-or-nothing thinking again') and move on."],tips:"Noticing a thought and being ruled by it are two different things. This exercise builds the distance between them.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"How to Observe Your Thoughts \u2014 Mindfulness & CBT (YouTube)"},{id:"Thought_Record_Basics",name:"Simplified Thought Record",parameters:["CDT"],goals:["Begin challenging distorted thinking","Build cognitive flexibility"],score_ranges:{CDT:"3-5"},duration_minutes:5,frequency:"3x per week",description:"A beginner-friendly CBT thought record. Focuses on 3 steps: noticing the thought, naming the distortion, writing one more balanced counter-thought.",research_basis:"Beck CBT simplified protocols; CBT self-help research",tutorial_steps:["When you notice a strong negative feeling, write down the thought causing it.","Name the type of distortion: All-or-nothing / Catastrophizing / Mind reading / Overgeneralization / Self-labeling / Should statements.","Write ONE more balanced alternative thought \u2014 not positive, just more realistic.","Example: Thought: 'I always mess everything up.' Type: Overgeneralization. Balanced: 'I made a mistake today, but I've handled many things well this week.'"],tips:"You don't have to eliminate the distorted thought \u2014 just create a crack in its certainty.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"CBT Thought Record \u2014 Beginners Guide (YouTube)"},{id:"Challenge_Questions",name:"Challenge Questions for Negative Thoughts",parameters:["CDT","ANX"],goals:["Systematically question distorted thoughts","Build critical thinking about beliefs"],score_ranges:{CDT:"3-5"},duration_minutes:5,frequency:"Whenever a strong negative thought appears",description:"A set of Socratic questions from CBT that challenge automatic negative thoughts by examining their validity, usefulness, and alternatives.",research_basis:"Socratic questioning in CBT (Beck, 1979); Cognitive restructuring",tutorial_steps:["When a negative thought arises, run it through these questions:","1. Is this thought based on facts or feelings?","2. What is the actual evidence FOR this thought?","3. What is the evidence AGAINST it?","4. What would I tell my best friend if they had this thought?","5. What's the most realistic outcome \u2014 not worst, not best?","6. Is this thought helpful to me right now?","Write brief answers or go through mentally."],tips:"The questions work best when written out at least the first few times.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"Challenging Negative Thoughts \u2014 CBT Techniques (YouTube)"},{id:"Balanced_Thinking",name:"Balanced Thinking Practice",parameters:["CDT"],goals:["Build habitual balanced thinking","Replace extreme thinking patterns"],score_ranges:{CDT:"3-5"},duration_minutes:5,frequency:"Daily",description:"A daily practice of deliberately generating balanced perspectives alongside negative ones \u2014 training the brain to default toward nuanced thinking.",research_basis:"CBT cognitive restructuring; Cognitive flexibility research",tutorial_steps:["Once a day, identify one situation you've been thinking about negatively.","Write the negative thought first \u2014 honestly.","Then write an equally plausible positive or neutral interpretation.","Then write the balanced view: 'The truth is probably somewhere between these two.'","Practice holding both perspectives in mind simultaneously."],tips:"Balanced thinking is not toxic positivity. It acknowledges the negative AND includes what the negative view is missing.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"Balanced Thinking \u2014 CBT Core Skill (YouTube)"},{id:"Daily_Thought_Record",name:"Daily Full Thought Record",parameters:["CDT","DEP","ANX"],goals:["Systematically address moderate-severe cognitive distortions"],score_ranges:{CDT:"6-8"},duration_minutes:10,frequency:"Daily",description:"The full CBT thought record applied daily for moderate-severe cognitive distortions. Consistent daily use creates measurable change within 3-6 weeks.",research_basis:"Beck (1979); CBT efficacy for cognitive distortions; NICE guidelines",tutorial_steps:["SITUATION: What happened? Where, when, who was involved?","AUTOMATIC THOUGHT: Write the exact thought.","DISTORTION TYPE: Label it (catastrophizing, all-or-nothing, mind reading, etc.)","EMOTION: Name and rate 0-100.","EVIDENCE FOR: Facts that support the thought.","EVIDENCE AGAINST: Facts that challenge it.","BALANCED THOUGHT: A realistic alternative acknowledging both sides.","RE-RATE EMOTION: What's the intensity now?","Do this daily for minimum 3 weeks. Change is cumulative."],tips:"The first week feels mechanical. By week 3, the questioning becomes automatic. Consistency is the mechanism.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"Full CBT Thought Record \u2014 Daily Practice (YouTube)"},{id:"Evidence_For_Against",name:"Evidence For & Against",parameters:["CDT","ANX"],goals:["Test the reality of a feared or negative belief","Reduce catastrophizing"],score_ranges:{CDT:"6-8"},duration_minutes:10,frequency:"For recurring feared thoughts",description:"A targeted CBT exercise examining a specific feared belief by rigorously listing factual evidence on both sides \u2014 like being your own defense attorney.",research_basis:"Beck CBT Dysfunctional Thought Record; Evidence-based cognitive restructuring",tutorial_steps:["Write the feared belief as a specific statement (e.g., 'If I fail this presentation, my career is over.').","Column A \u2014 Evidence FOR: List only facts (not feelings) that support this belief.","Column B \u2014 Evidence AGAINST: List facts that contradict or complicate this belief. Include past exceptions and others' perspectives.","Rate belief strength before and after (0-100%).","Write a balanced conclusion that integrates both columns."],tips:"'I feel like a failure' is not evidence. 'I received negative feedback on two projects' is. Only facts go in the FOR column.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"Evidence For and Against \u2014 CBT Technique (YouTube)"},{id:"Reality_Testing",name:"Reality Testing",parameters:["CDT"],goals:["Test distorted beliefs against real-world evidence"],score_ranges:{CDT:"6-8"},duration_minutes:10,frequency:"For specific feared outcomes",description:"A behavioral experiment where you test whether distorted beliefs are actually true by collecting real evidence \u2014 moving from thinking to testing.",research_basis:"CBT behavioral experiments (Bennett-Levy et al., 2004)",tutorial_steps:["Identify a belief you hold strongly (e.g., 'Everyone thinks I'm incompetent at work').","Design a small test: what evidence could you collect? (e.g., 'I'll notice how people respond to my next 5 contributions in meetings')","Collect evidence over 3-7 days. Write it down.","Review: does real-world evidence support or contradict the belief?","Update the belief based on evidence, not feeling."],tips:"Cognitive distortions survive because we never test them. Behavioral testing uses real data.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"CBT Behavioral Experiments \u2014 Testing Your Beliefs (YouTube)"},{id:"Intensive_Thought_Tracking",name:"Intensive Thought Tracking",parameters:["CDT"],goals:["Map distortion patterns comprehensively","Enable targeted CBT work"],score_ranges:{CDT:"9-10"},duration_minutes:10,frequency:"Daily, every significant negative thought",description:"For severe cognitive distortions, intensive tracking of every significant negative thought throughout the day maps the full pattern for targeted professional CBT work.",research_basis:"CBT severe distortion protocols; Thought monitoring in CBT-D and CBT-A",tutorial_steps:["Keep a note available throughout the day.","Every time you have a significant negative thought, log it: time, trigger, thought, distortion type, emotion 0-100.","At end of each day: review all entries. Which distortion type comes up most?","Bring your tracking log to sessions with a professional if you have one.","After 2 weeks: identify your 2-3 most frequent distortion patterns. These are your targets."],tips:"Severity at this level warrants professional CBT alongside self-help. Use this tracking to support professional work.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"Intensive Thought Monitoring for CBT (YouTube)"},{id:"Professional_CBT_Referral",name:"Find a CBT Professional",parameters:["CDT"],goals:["Access professional CBT for severe distortions"],score_ranges:{CDT:"9-10"},duration_minutes:10,frequency:"One-time action",description:"Severe cognitive distortions have a strong evidence base for professional CBT treatment. Self-help can support but not replace structured CBT at this level.",research_basis:"NICE guidelines for CBT; CBT efficacy meta-analysis (Butler et al., 2006)",tutorial_steps:["Search for a therapist specifically trained in CBT.","Ask directly: 'Do you use CBT? Do you have experience with cognitive distortions?'","For online options: look for platforms that match with CBT-trained therapists.","Take your thought tracking log to the first session.","Commit to at least 8-12 sessions before assessing effectiveness."],tips:"For severe cognitive distortions, CBT has strong evidence of effectiveness.",video_url:"https://www.youtube.com/watch?v=MIr3RsUWrdo",video_title:"What is CBT and How to Find a CBT Therapist (YouTube)"},{id:"Distortion_Log",name:"Cognitive Distortion Log",parameters:["CDT"],goals:["Track and categorize distortions systematically","Build metacognitive awareness of patterns"],score_ranges:{CDT:"9-10"},duration_minutes:5,frequency:"Daily ongoing",description:"A structured daily log organized by distortion type, designed to reveal patterns and track change over time in severe cognitive distortion.",research_basis:"CBT dysfunctional thought diary; Beck Cognitive Distortions taxonomy",tutorial_steps:["Keep a table: Date, Thought, Distortion Type, Emotion before (0-100), Balanced thought, Emotion after (0-100).","Fill in at least one row per day.","Weekly: count how many of each distortion type appeared. Which is most frequent?","Focus your challenging efforts on your most frequent type.","Track emotion before/after scores over weeks \u2014 improvement shows up in these numbers."],tips:"The distortion log turns an abstract problem into concrete, trackable data. That data is what makes change measurable.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"Cognitive Distortion Log \u2014 How to Track Thinking Patterns (YouTube)"},{id:"Encourage_First_Checkin",name:"Complete Your First Check-In",parameters:["ENG"],goals:["Begin app engagement","Establish the first habit"],score_ranges:{ENG:"0-2"},duration_minutes:2,frequency:"Today",description:"The hardest step is the first one. Completing one check-in now starts the engagement loop and gives you real data about yourself.",research_basis:"Habit formation; Behavioral initiation research",tutorial_steps:["Open the app right now.","Complete today's mood and wellbeing check-in \u2014 it takes 2 minutes.","Read your results.","That's it \u2014 you just completed your first step."],tips:"You don't need to feel ready. Just do the 2-minute check-in. Everything else follows.",video_url:null,video_title:null},{id:"One_Exercise_Today",name:"Try One Exercise Today",parameters:["ENG"],goals:["Experience the app's exercises","Build confidence in self-help tools"],score_ranges:{ENG:"0-2"},duration_minutes:5,frequency:"Today",description:"Trying one exercise \u2014 even briefly \u2014 shifts the experience from passive to active and increases the likelihood of return.",research_basis:"Behavioral activation; App engagement research",tutorial_steps:["Choose any exercise from your suggested list.","Do it now \u2014 don't wait for the 'right time'.","Rate how you feel before and after on 1-10.","You just completed one full cycle. You know this tool works."],tips:"The 'right time' is a myth. Starting any time is the right time.",video_url:null,video_title:null},{id:"App_Reminder_Setup",name:"Set an App Reminder",parameters:["ENG"],goals:["Use external cue to build habit","Overcome low engagement inertia"],score_ranges:{ENG:"0-2"},duration_minutes:2,frequency:"One-time setup",description:"External reminders are one of the most effective habit-formation tools. Setting a daily reminder removes the memory burden and creates a consistent cue.",research_basis:"Habit formation (Duhigg, 2012); Implementation intentions (Gollwitzer, 1999)",tutorial_steps:["Set a daily phone alarm for a consistent time \u2014 ideally morning or evening.","Label it something motivating: 'Mentora \u2014 5 mins for me'.","When it goes off: open the app immediately and complete a check-in.","Don't dismiss and delay \u2014 that defeats the habit loop."],tips:"Attaching the check-in to an existing daily habit (coffee, brushing teeth) makes it even more reliable.",video_url:null,video_title:null},{id:"Daily_Reminder_Set",name:"Set Your Daily Routine",parameters:["ENG"],goals:["Build consistent daily use","Transition from sporadic to habitual use"],score_ranges:{ENG:"3-5"},duration_minutes:5,frequency:"Daily",description:"Moving from occasional to daily use requires a simple, consistent routine.",research_basis:"Habit loop (cue-routine-reward); Consistency in digital mental health tools",tutorial_steps:["Choose a specific time for your daily check-in (e.g., 8 AM, or 9 PM).","Decide the context: in bed, at your desk, with coffee.","Set a recurring alarm for this time.","Commit to 7 consecutive days. After 7 days: has it become more automatic?"],tips:"Same time + same place = fastest habit formation. The context itself becomes the cue.",video_url:null,video_title:null},{id:"Exercise_Challenge",name:"5-Day Exercise Challenge",parameters:["ENG"],goals:["Build exercise completion habit","Experience progress over multiple days"],score_ranges:{ENG:"3-5"},duration_minutes:10,frequency:"Daily for 5 days",description:"A structured 5-day challenge to build the habit of completing daily exercises. Short, defined challenges are highly effective for habit initiation.",research_basis:"Habit formation short challenge structures; Behavioral Activation",tutorial_steps:["Choose one exercise type to focus on for 5 days (e.g., breathing, journaling, or CBT).","Do it every day for 5 days at the same time.","Track completion each day \u2014 even just a checkmark.","At end of day 5: how did it feel? Did it get easier?","If yes: extend to 7 days, then 14."],tips:"5 days is short enough to commit to, long enough to feel the benefit.",video_url:null,video_title:null},{id:"Streak_Goal_3_Days",name:"Build a 3-Day Streak",parameters:["ENG"],goals:["Experience momentum through consistency"],score_ranges:{ENG:"3-5"},duration_minutes:5,frequency:"Daily",description:"A 3-day streak goal is concrete, achievable, and motivating. Short streak goals build the consistency muscle.",research_basis:"Gamification and habit formation; Short-goal commitment research",tutorial_steps:["Set a goal: 3 consecutive days of check-ins and at least one exercise each day.","Each day: open the app, complete check-in, do one exercise.","After day 3: celebrate. Then set a new goal of 7 days.","If you miss a day: restart the 3-day count from the next day. Never quit \u2014 just restart."],tips:"Missing once doesn't break a habit. Missing twice starts to. The rule is: never miss twice.",video_url:null,video_title:null},{id:"Celebrate_Progress",name:"Celebrate Your Progress",parameters:["ENG"],goals:["Reinforce consistent engagement","Build intrinsic motivation"],score_ranges:{ENG:"6-8"},duration_minutes:5,frequency:"Weekly",description:"Recognizing and celebrating progress is one of the most evidence-based ways to sustain long-term behavior change.",research_basis:"Self-Determination Theory; Positive reinforcement; Progress principle (Amabile & Kramer)",tutorial_steps:["Once a week, take 5 minutes to review your week.","Write: What did I actually do this week? (exercises completed, check-ins, insights)","Write: What difference did I notice? Even small ones count.","Acknowledge the effort: 'I showed up for myself this week. That matters.'","Set one intention for next week."],tips:"Progress feels invisible when you don't track it. This reflection makes progress visible \u2014 which is what sustains motivation.",video_url:null,video_title:null},{id:"Streak_Building",name:"Build a 14-Day Streak",parameters:["ENG"],goals:["Solidify daily engagement as a habit"],score_ranges:{ENG:"6-8"},duration_minutes:5,frequency:"Daily",description:"14 days of consistent daily practice crosses the initial habit formation threshold.",research_basis:"Habit automaticity research (Lally et al., 2010); Self-Determination Theory",tutorial_steps:["Commit to 14 consecutive days of daily check-in + one exercise.","Track each day. Protect the streak.","On day 7: how is it feeling vs. day 1?","On day 14: what's changed? What feels more automatic?"],tips:"The goal is automaticity \u2014 the feeling that checking in requires less conscious effort. That's the habit forming.",video_url:null,video_title:null},{id:"Weekly_Reflection",name:"Weekly Reflection",parameters:["ENG","CDT"],goals:["Deepen learning from daily practice","Connect progress to wellbeing changes"],score_ranges:{ENG:"6-8"},duration_minutes:10,frequency:"Weekly",description:"Regular structured reflection consolidates learning and identifies patterns, making the self-help work progressively more effective.",research_basis:"Reflective practice research; Kolb learning cycle; CBT session review",tutorial_steps:["At the end of each week, write answers to:","1. What exercises did I do? Which felt most useful?","2. What did I notice about my mood/anxiety/stress this week?","3. What pattern am I seeing?","4. What do I want to focus on next week?","Keep it under 10 minutes."],tips:"Reflection turns experience into learning. Without it, you practice but don't progress.",video_url:null,video_title:null},{id:"Acknowledge_Dedication",name:"Acknowledge Your Dedication",parameters:["ENG"],goals:["Reinforce excellent engagement","Build identity-based motivation"],score_ranges:{ENG:"9-10"},duration_minutes:5,frequency:"Monthly",description:"For users with excellent engagement, acknowledging dedication deepens intrinsic motivation and self-efficacy.",research_basis:"Self-Determination Theory (Deci & Ryan); Intrinsic motivation and sustained behavior",tutorial_steps:["Take 5 minutes to write about your journey: where you started, what's different now.","Be specific about what you've done and what it cost you in effort.","Acknowledge that consistently showing up for your mental health is not trivial.","Write: 'I am someone who takes care of my mental health. This is part of who I am.'"],tips:"Identity-based reinforcement ('I am the kind of person who...') is more powerful for long-term behavior than reward-based reinforcement.",video_url:null,video_title:null},{id:"Deepen_Reflection",name:"Deep Monthly Reflection",parameters:["ENG"],goals:["Extract maximum insight from sustained practice","Identify long-term patterns"],score_ranges:{ENG:"9-10"},duration_minutes:20,frequency:"Monthly",description:"For highly engaged users, a monthly deep reflection session extracts the most from sustained practice.",research_basis:"Reflective practice; CBT case conceptualization self-application",tutorial_steps:["Review the past month's data: scores, exercises, patterns.","Write: What has genuinely changed? What hasn't changed yet? What do I understand about myself now that I didn't before?","Identify: What is my biggest remaining challenge area?","Set one specific goal for next month with a concrete plan.","Write: What kind of mental health do I want in 3 months, and what will get me there?"],tips:"Month-level reflection reveals gradual changes that are only visible when you look at the longer arc.",video_url:null,video_title:null},{id:"Share_Success",name:"Share Your Progress",parameters:["ENG","SOC"],goals:["Reinforce behavior through social sharing","Potentially inspire others"],score_ranges:{ENG:"9-10"},duration_minutes:5,frequency:"When significant milestones occur",description:"Sharing progress with trusted others reinforces commitment through social accountability.",research_basis:"Social accountability in behavior change; Narrative identity research",tutorial_steps:["Think of one meaningful change or insight from your mental health work.","Share it with one person you trust \u2014 a friend, family member, or community.","You don't have to share everything \u2014 just one real thing that's changed.","Notice how sharing it affects your own relationship to the progress."],tips:"Naming our progress out loud makes it more real and more lasting.",video_url:null,video_title:null},{id:"No_Crisis_Action",name:"Continue Normal Coping",parameters:["SAFE"],goals:["Maintain emotional safety through regular coping"],score_ranges:{SAFE:"0-2"},duration_minutes:0,frequency:"Ongoing",description:"No crisis indicators present. Continue regular wellbeing practices and daily check-ins.",research_basis:"C-SSRS safety confirmation protocols",tutorial_steps:["Continue your regular exercises and check-ins.","If anything changes in how you feel, the app's check-in will catch it.","It's always okay to talk to someone you trust about how you're feeling."],tips:"Regular check-ins are what catch changes early \u2014 before they become crises.",video_url:null,video_title:null},{id:"Normal_Coping_Support",name:"Everyday Coping Toolkit",parameters:["SAFE"],goals:["Maintain emotional resilience","Build protective coping habits"],score_ranges:{SAFE:"0-2"},duration_minutes:10,frequency:"Daily",description:"Building a personal toolkit of coping strategies that work for you \u2014 before a crisis \u2014 is one of the most protective things you can do.",research_basis:"Resilience research; Proactive coping; Crisis prevention",tutorial_steps:["Write a list of 5-7 things that help you feel better when you're having a hard day.","Include physical (walk, shower, food), social (call someone), and mental (journaling, breathing).","Rate each 1-5 for how well they work.","Save this list where you can find it easily.","Next time you're struggling: go to the list FIRST before defaulting to unhelpful coping."],tips:"The best coping strategies are the ones YOU know work for you specifically.",video_url:null,video_title:null},{id:"Ask_About_Supports",name:"Identify Your Support Network",parameters:["SAFE"],goals:["Map available support before it's needed urgently"],score_ranges:{SAFE:"3-5"},duration_minutes:10,frequency:"Once now, update regularly",description:"When feeling passive distress or pain, mapping your support network is the most important protective step.",research_basis:"Safety planning research; Social support and suicide prevention",tutorial_steps:["Write the names of people in your life you could reach out to if struggling.","Include: one family member, one friend, one professional contact if available.","For each: what would you say? How would you reach them?","Also write: what is one thing I can do for myself when I'm struggling?","Keep this list accessible."],tips:"Knowing your supports before you need them means you don't have to figure it out at your lowest.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"Building Your Support Network (YouTube)"},{id:"Suggest_Talk_Trusted_Person",name:"Talk to Someone You Trust",parameters:["SAFE"],goals:["Break silence around distress","Access human support immediately"],score_ranges:{SAFE:"3-5"},duration_minutes:15,frequency:"Today",description:"When experiencing passive suicidal thoughts or intense pain, talking to a trusted person is the most evidence-based protective action.",research_basis:"Crisis intervention; Social support and suicide prevention research",tutorial_steps:["Identify one person you trust.","Contact them today: 'I've been having a really hard time and I needed to talk to someone.'","Let them respond. Let them support you.","If talking feels too hard: text. If texting feels too hard: call.","If there is no one: contact a support line. findahelpline.com has options by country."],tips:"Keeping pain completely private increases risk. Breaking the silence \u2014 even once, with one person \u2014 is protective.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"How to Talk About Suicidal Thoughts (YouTube)"},{id:"Encourage_Professional_Help",name:"Reach Out to a Professional",parameters:["SAFE"],goals:["Connect to professional mental health support"],score_ranges:{SAFE:"3-5"},duration_minutes:10,frequency:"Today",description:"Passive suicidal thoughts or intense emotional pain warrant professional support. This is the appropriate level of care.",research_basis:"C-SSRS passive ideation protocol; SAFE-T assessment",tutorial_steps:["Contact your doctor, therapist, or mental health line today.","Tell them honestly what you've been experiencing.","If you don't have a therapist: ask your doctor for a referral or call a mental health line.","Egypt: 08008880700. International: findahelpline.com","You don't have to be 'bad enough' to deserve professional support."],tips:"Seeking professional help at this stage is prevention, not crisis response.",video_url:"https://www.youtube.com/watch?v=MIr3RsUWrdo",video_title:"How to Seek Mental Health Help (YouTube)"},{id:"Encourage_Professional_Help_Strong",name:"Seek Professional Help Urgently",parameters:["SAFE"],goals:["Urgent connection to mental health professional"],score_ranges:{SAFE:"6-8"},duration_minutes:0,frequency:"Now",description:"Active thoughts of death or self-harm require immediate professional support. This is a medical situation.",research_basis:"C-SSRS moderate risk protocol; Crisis intervention",tutorial_steps:["Contact a mental health professional today \u2014 not this week, today.","If you have a therapist: contact them now and describe your current thoughts.","If you don't: go to the nearest hospital emergency department or call a crisis line.","Egypt: 08008880700. International: findahelpline.com","Tell someone you trust what you're experiencing and ask them to stay with you or check in."],tips:"These thoughts deserve immediate professional attention. You are not a burden. You deserve this support.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"Crisis Support Resources (YouTube)"},{id:"Safety_Plan_Detail",name:"Detailed Safety Plan",parameters:["SAFE"],goals:["Create immediate crisis protocol","Build safety structure"],score_ranges:{SAFE:"6-8"},duration_minutes:20,frequency:"Build now, review with professional",description:"A detailed written safety plan for moderate-to-high risk. The Stanley-Brown Safety Planning Intervention has strong evidence for reducing suicide risk.",research_basis:"Stanley & Brown (2012) Safety Planning Intervention; SAFE-T protocol; C-SSRS",tutorial_steps:["WARNING SIGNS: What thoughts, feelings, or situations signal a crisis is building?","INTERNAL COPING: 3 things you can do ALONE to reduce distress right now.","PEOPLE/PLACES: 2-3 people or places to be around others \u2014 just to not be alone.","TRUSTED PEOPLE: 2 people you can tell when you're in crisis. Names and how to reach them.","PROFESSIONALS: Therapist name and number. Crisis line number.","MEANS REDUCTION: Is there anything at home that could be used to hurt yourself? Plan to reduce your access to it.","Print this or save it where you can find it in a crisis."],tips:"Build this with the help of a professional if possible. Reviewed safety plans are more effective than ones built alone.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"The Stanley-Brown Safety Planning Intervention (YouTube)"},{id:"Crisis_Immediate",name:"Immediate Crisis Action",parameters:["SAFE"],goals:["Immediate safety"],score_ranges:{SAFE:"9+"},duration_minutes:0,frequency:"Right now",description:"Immediate danger requires immediate action. Your safety is the only priority right now.",research_basis:"Crisis intervention; Emergency mental health protocols",tutorial_steps:["Call emergency services in your country RIGHT NOW (Egypt: 123 police, or go to nearest hospital).","Or call a crisis line: Egypt 08008880700. International: findahelpline.com","If possible: go to someone you trust immediately and ask them to stay with you.","If you have access to means: put distance between yourself and them right now.","You are worth saving. Help is available."],tips:"This is a medical emergency. Please reach out to emergency services or crisis support right now.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"Crisis Helpline \u2014 How to Get Immediate Help (YouTube)"},{id:"Emergency_Services_Info",name:"Emergency Services",parameters:["SAFE"],goals:["Access emergency mental health support immediately"],score_ranges:{SAFE:"9+"},duration_minutes:0,frequency:"Now",description:"Emergency contacts for immediate mental health crisis.",research_basis:"Crisis intervention protocol",tutorial_steps:["Egypt emergency: Call 123 (police) or go to nearest hospital emergency department.","Egypt mental health line: 08008880700","International crisis lines: findahelpline.com","If you cannot call: text a crisis line where available.","If you are with someone: show them this screen and ask for help."],tips:"You do not have to be 'certain' to call. Feeling unsafe is enough reason.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"Emergency Mental Health Resources (YouTube)"},{id:"Ask_Someone_To_Stay_With_You",name:"Ask Someone to Stay With You",parameters:["SAFE"],goals:["Immediate human presence as protective factor"],score_ranges:{SAFE:"9+"},duration_minutes:0,frequency:"Right now",description:"Human presence is one of the most protective factors in acute crisis. Asking someone to be with you is a direct safety action.",research_basis:"Crisis intervention; Means restriction and presence as protective factors",tutorial_steps:["Text or call the person closest to you right now.","Say: 'I'm having a really hard time and I need someone to be with me.'","You don't have to explain everything. Just ask them to come or stay on the phone.","If no one is reachable: go to a public place or a hospital. Not alone."],tips:"Asking for presence is not dramatic or a burden. It is the right thing to do right now.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"How to Ask for Help in a Crisis (YouTube)"},{id:"Ask_Remove_Means",name:"Reduce Access to Means",parameters:["SAFE"],goals:["Direct risk reduction through means restriction"],score_ranges:{SAFE:"9+"},duration_minutes:5,frequency:"Now",description:"Means restriction is one of the most evidence-based suicide prevention interventions. Creating distance between yourself and potential means saves lives.",research_basis:"Means restriction and suicide prevention (Mann et al., 2005); SAFE-T means restriction protocol",tutorial_steps:["Think about what you might use to hurt yourself.","Remove it from your immediate environment right now \u2014 give it to someone, lock it away, leave it elsewhere.","Ask someone you trust to hold onto it: 'Can you hold onto this for me for a while?'","You don't have to explain why.","Even one step of distance creates time \u2014 and time is what makes crisis survivable."],tips:"Most suicide attempts happen impulsively. Means restriction extends the time between impulse and access \u2014 and that time is life-saving.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"Means Restriction \u2014 A Life-Saving Intervention (YouTube)"}]},519,[]);
__d(function(e,t,i,o,s,a,n){s.exports=[{id:"Gratitude_Journal_3xWeek",name:"Gratitude Journal",parameters:["DEP","SOC"],goals:["Shift attention toward positives","Lift mood gently","Build positive thought habits"],score_ranges:{DEP:"0-4"},duration_minutes:5,frequency:"3 times per week",description:"A well-studied positive psychology exercise. Writing 3 specific, detailed things you're grateful for trains your brain over time to notice more positive experiences \u2014 directly countering the negativity bias of depression.",research_basis:"Emmons & McCullough (2003); Positive psychology meta-analysis; PHQ-9 mild depression protocols",tutorial_steps:["Open a notebook or notes app. Write today's date.","Write 3 things you are grateful for. Be SPECIFIC \u2014 not 'my family' but 'my sister sent me a funny voice message this morning that made me smile'.","For each one, write 1 sentence about why it matters to you.","Optional: think of one person you appreciate and why.","Close the journal. It should take no more than 5 minutes."],tips:"Specificity is what makes this work. Vague gratitude fades quickly; vivid, detailed appreciation sticks.",video_url:"https://www.youtube.com/watch?v=WPPPFqsECz0",video_title:"Gratitude Journaling \u2014 The Science Behind It (YouTube)"},{id:"Light_Stretching_10min",name:"Light Stretching",parameters:["DEP","ANX","SLP"],goals:["Release physical tension","Re-energize body gently","Counteract low-energy depression"],score_ranges:{DEP:"0-4"},duration_minutes:10,frequency:"Daily, ideally morning or evening",description:"Gentle movement breaks the physical stillness that reinforces depression. Even 10 minutes of light stretching increases blood flow, releases mild endorphins, and helps the body feel less stuck.",research_basis:"Behavioral Activation body movement; Exercise and depression meta-analysis (Schuch, 2016)",tutorial_steps:["Stand or sit on the floor. Take 3 slow breaths.","NECK: Drop right ear to right shoulder, hold 20 seconds. Repeat left.","SHOULDERS: Roll both shoulders backward 5 times, then forward 5 times.","CHEST OPENER: Clasp hands behind back, lift chest, squeeze shoulder blades gently. Hold 15 seconds.","FORWARD FOLD: Standing, slowly fold forward, letting head and arms hang. Hold 30 seconds and breathe.","SEATED TWIST: Sit cross-legged, right hand on left knee, gently twist left. Hold 20 seconds each side.","End lying flat for 1 minute, eyes closed, breathing slowly."],tips:"Never stretch to the point of pain. Gentle tension you breathe into is the goal.",video_url:"https://www.youtube.com/watch?v=L_xrDAtykMI",video_title:"10-Minute Morning Stretch for Energy (YouTube)"},{id:"Social_Activity_Weekly",name:"Weekly Social Activity",parameters:["DEP","SOC"],goals:["Prevent isolation","Maintain connection during mild depression"],score_ranges:{DEP:"0-4"},duration_minutes:30,frequency:"Once per week minimum",description:"Mild depression quietly pulls people toward isolation. Scheduling one social activity weekly \u2014 however small \u2014 interrupts this before it deepens.",research_basis:"Behavioral Activation social scheduling; UCLA Loneliness Scale interventions",tutorial_steps:["Think of one social interaction you could have this week \u2014 coffee, a phone call, or any group activity.","Schedule it now with a specific day, time, and person.","Show up even if you don't feel like it \u2014 especially then.","After: note how you felt before vs. after on a 1-10 scale."],tips:"It doesn't have to be a big event. A 20-minute coffee counts. The goal is breaking the isolation pattern.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Social Connection and Mental Health (YouTube)"},{id:"Behavioral_Activation_Plan",name:"Behavioral Activation Plan",parameters:["DEP"],goals:["Break the depression-inactivity cycle","Reintroduce pleasure and achievement"],score_ranges:{DEP:"5-9"},duration_minutes:15,frequency:"Weekly planning + daily micro-actions",description:"The gold-standard behavioral treatment for depression. Depression causes withdrawal; withdrawal deepens depression. Behavioral Activation deliberately schedules small meaningful activities to break this cycle \u2014 even when motivation is absent.",research_basis:"Jacobson et al. (1996); NICE depression guidelines; Dozens of RCTs",tutorial_steps:["Make two lists: things that used to give you pleasure, and things that give a sense of accomplishment.","Rate each 0-10 for effort required right now.","Start with the lowest-effort items.","Schedule ONE activity for tomorrow with a specific time. (e.g., 'Walk for 10 minutes at 9 AM')","After doing it, rate mood before vs. after on 1-10.","Gradually build to 2-3 activities per day over 2 weeks."],tips:"You don't need motivation to start. In depression, motivation follows action \u2014 not the other way around.",video_url:"https://www.youtube.com/watch?v=MCdmABNzaos",video_title:"Behavioral Activation for Depression Explained (YouTube)"},{id:"Connect_With_One_Person",name:"Connect With One Person",parameters:["DEP","SOC"],goals:["Break isolation","Reactivate social bonds during mild depression"],score_ranges:{DEP:"5-9"},duration_minutes:5,frequency:"Once this week, then build",description:"Depression narrows the world. This exercise makes re-connection as low-barrier as possible \u2014 one message, no expectation of a long conversation.",research_basis:"Behavioral Activation social component; PHQ-9 social recovery indicators",tutorial_steps:["Think of ONE person you haven't reached out to recently but care about.","Send them ONE message \u2014 as simple as: 'Hey, thinking of you. Hope you're okay.'","You don't need to share how you're feeling or have a big conversation.","Notice how you feel after sending it compared to before."],tips:"Depression tells you reaching out is pointless. Do it anyway. The evidence usually proves it wrong.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Reconnecting When You're Depressed (YouTube)"},{id:"Enjoyable_Activity_15min",name:"Pleasant Activity \u2014 15 Minutes",parameters:["DEP","ENG"],goals:["Restore enjoyment","Counteract anhedonia"],score_ranges:{DEP:"5-9"},duration_minutes:15,frequency:"Daily",description:"A core Behavioral Activation component. Depression suppresses the brain's reward system. Scheduling one small pleasurable activity daily begins gently restoring it.",research_basis:"BAT \u2014 Behavioral Activation Therapy; Anhedonia research (Treadway & Zald, 2011)",tutorial_steps:["Think of 5 activities that used to feel enjoyable OR that seem even 10% appealing right now.","Examples: one song you love, making a specific food, sitting outside, watching one episode.","Choose ONE for today. Schedule it at a specific time.","When it's time: do it, even without motivation.","After: rate 1-10 how you felt. Even 3/10 is progress."],tips:"Depression lies and says nothing will feel good. Even slightly less flat counts as progress.",video_url:"https://www.youtube.com/watch?v=MCdmABNzaos",video_title:"Pleasant Activities & Behavioral Activation (YouTube)"},{id:"CBT_Thought_Record_Daily",name:"CBT Thought Record",parameters:["DEP","ANX","CDT"],goals:["Challenge automatic negative thoughts","Reduce cognitive distortions","Improve mood"],score_ranges:{DEP:"10-14",ANX:"10-14",CDT:"6-8"},duration_minutes:10,frequency:"Daily or whenever a strong negative thought occurs",description:"The most researched exercise in CBT. A structured format to catch, examine, and reframe automatic negative thoughts. Used in clinical settings worldwide.",research_basis:"Beck (1979) CBT for Depression; NICE guidelines; 300+ RCTs",tutorial_steps:["SITUATION: What triggered the thought \u2014 where, what happened.","AUTOMATIC THOUGHT: Write the exact thought that appeared.","EMOTION: Name it and rate intensity 0-100.","EVIDENCE FOR: Facts (not feelings) that support the thought.","EVIDENCE AGAINST: Facts that challenge it. Use the 'best friend' perspective.","BALANCED THOUGHT: A realistic alternative that acknowledges both sides.","RE-RATE EMOTION: What is the intensity now? Even a 10-point drop is real progress."],tips:"Ask: 'What would I tell my best friend if they had this thought?' That answer is usually your balanced thought.",video_url:"https://www.youtube.com/watch?v=0eFuknUMkH4",video_title:"How to Complete a CBT Thought Record (YouTube)"},{id:"Behavioral_Activation_Micro_Steps",name:"Behavioral Activation \u2014 Micro Steps",parameters:["DEP"],goals:["Re-engage with daily life in tiny steps","Reduce overwhelm"],score_ranges:{DEP:"10-14"},duration_minutes:10,frequency:"Daily",description:"For moderate depression where even small tasks feel impossible, this version breaks everything into micro-steps of 5 minutes or less \u2014 removing the activation barrier completely.",research_basis:"Behavioral Activation Therapy moderate depression adaptations; Task breakdown research",tutorial_steps:["Pick ONE task from your day that feels too hard.","Break it into steps so small each takes under 5 minutes. (e.g., not 'clean room' \u2014 but 'pick up 3 things from the floor')","Do only step 1. Stop there if needed. That's a real win.","Rate mood before and after step 1 and write the number down.","If energy allows, do step 2. If not \u2014 step 1 still mattered."],tips:"The step should feel almost embarrassingly small. That is intentional \u2014 it bypasses the brain's resistance to starting.",video_url:"https://www.youtube.com/watch?v=MCdmABNzaos",video_title:"Micro Steps for Depression \u2014 Getting Unstuck (YouTube)"},{id:"Sleep_Routine_Checklist",name:"Sleep Routine Checklist",parameters:["DEP","SLP"],goals:["Stabilize sleep as depression support","Build a protective nightly routine"],score_ranges:{DEP:"10-14"},duration_minutes:0,frequency:"Every night",description:"Depression and poor sleep have a bidirectional relationship \u2014 each makes the other worse. A consistent sleep routine is a foundational intervention for moderate depression.",research_basis:"CBT-I; PHQ-9 sleep item; Sleep and depression comorbidity research",tutorial_steps:["Set a consistent bedtime and wake time \u2014 within 30 minutes every day including weekends.","No screens 45 minutes before bed.","Do a 5-minute body scan or breathing exercise in bed.","Keep the bedroom cool, dark, and used only for sleep.","If awake more than 20 minutes, get up and do something calm in dim light until sleepy.","Check off each habit nightly \u2014 the checklist itself becomes a routine signal."],tips:"Sleep consistency is as important as sleep duration. An irregular schedule confuses the brain even if total hours are okay.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"Sleep Hygiene for Depression (YouTube)"},{id:"Daily_Structure_Plan",name:"Daily Structure Plan",parameters:["DEP"],goals:["Create external scaffolding when internal motivation is absent"],score_ranges:{DEP:"15-19"},duration_minutes:10,frequency:"Plan each evening for the next day",description:"In moderately severe depression, the absence of structure allows hours of low mood and rumination. A simple daily schedule creates external anchors that keep the day moving even when motivation is very low.",research_basis:"Behavioral Activation scheduled component; PHQ-9 severe protocol",tutorial_steps:["Each evening, write tomorrow's schedule hour by hour \u2014 meals, basic hygiene, one small activity, one brief social touchpoint.","Keep expectations very low \u2014 the goal is structure, not productivity.","Morning: look at your schedule and follow it like an appointment you can't cancel.","Evening: check off what you did. Even 2 of 5 items is a real day."],tips:"Structure is medicine for severe depression. It reduces the hours the brain spends in unstructured low mood.",video_url:"https://www.youtube.com/watch?v=MCdmABNzaos",video_title:"Building Structure for Severe Depression (YouTube)"},{id:"Behavioral_Activation_Scheduled",name:"Scheduled Behavioral Activation",parameters:["DEP"],goals:["Maintain activity despite severe low mood","Prevent complete withdrawal"],score_ranges:{DEP:"15-19"},duration_minutes:15,frequency:"Pre-scheduled activities daily",description:"For severe depression, activities must be scheduled in advance \u2014 not chosen in the moment \u2014 because in-the-moment motivation is unavailable.",research_basis:"Jacobson BA for severe depression; Pre-commitment research (Gollwitzer, 1999)",tutorial_steps:["Schedule 2-3 specific activities for tomorrow NOW \u2014 not 'when you feel like it'.","Keep activities simple: a 10-min walk at 10 AM, one meal cooked at home, 5 minutes of stretching.","When the scheduled time comes: start the activity regardless of mood. Set a timer for just 5 minutes.","After 5 minutes: you may stop or continue. But the starting is the goal.","Track each activity: done / not done. Patterns emerge over a week."],tips:"Pre-scheduling bypasses the depressed brain's 'I don't feel like it'. You made the decision when you were slightly more resourced.",video_url:"https://www.youtube.com/watch?v=MCdmABNzaos",video_title:"Behavioral Activation for Severe Depression (YouTube)"},{id:"Professional_Help_Info",name:"Finding Professional Support",parameters:["DEP","ANX"],goals:["Connect to professional mental health care"],score_ranges:{DEP:"15-19",ANX:"15-21"},duration_minutes:10,frequency:"One-time action",description:"At this severity level, professional support significantly improves outcomes. This exercise helps take the concrete first step toward finding a therapist or counselor.",research_basis:"NICE guidelines for moderate-severe depression and anxiety",tutorial_steps:["Acknowledge: reaching out for professional help is a sign of strength.","Identify what's available to you: therapist, counselor, psychiatrist, community mental health center.","Write ONE specific action you can take today: search online, call your insurance, ask your doctor.","Do that one action today.","If cost is a barrier: look for sliding-scale therapists, community health centers, or lower-fee online platforms."],tips:"You don't have to feel ready. Making the appointment is the first step \u2014 readiness often comes after.",video_url:"https://www.youtube.com/watch?v=MIr3RsUWrdo",video_title:"How to Find a Therapist \u2014 Step by Step (YouTube)"},{id:"Crisis_Support_Resources",name:"Crisis Support Resources",parameters:["DEP","SAFE"],goals:["Immediate safety support","Connect to crisis services"],score_ranges:{DEP:"20-27"},duration_minutes:0,frequency:"Immediate",description:"At this severity level, professional and crisis support is essential. This provides immediate, actionable resources.",research_basis:"C-SSRS crisis protocol; SAFE-T; WHO crisis guidelines",tutorial_steps:["You are not alone and you deserve support right now.","Call or text a crisis line. In Egypt: 08008880700. International: findahelpline.com","Tell someone you trust how you are feeling.","If you are in immediate danger: go to the nearest emergency room or call emergency services.","Do not be alone right now if possible."],tips:"Crisis lines are confidential and free. The people there are trained specifically for moments like this.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"How to Use a Crisis Helpline (YouTube)"},{id:"Safety_Plan_Building",name:"Personal Safety Plan",parameters:["DEP","SAFE"],goals:["Create a clear crisis protocol","Reduce risk during high distress"],score_ranges:{DEP:"20-27",SAFE:"6-8"},duration_minutes:20,frequency:"Create once, review monthly",description:"A written plan for what to do when distress becomes overwhelming. Evidence shows a personalized safety plan significantly reduces crisis escalation.",research_basis:"Stanley & Brown Safety Planning Intervention (2012); SAFE-T protocol",tutorial_steps:["WARNING SIGNS: Write feelings, thoughts, or situations that signal your distress is escalating.","INTERNAL COPING: 3 things you can do alone to reduce distress (walk, breathe, music).","SOCIAL DISTRACTION: 2-3 people or places you can go to \u2014 not to talk about crisis, just to not be alone.","TRUSTED PEOPLE: 2 people you can tell when you're really struggling.","PROFESSIONAL CONTACTS: Therapist/counselor number + a crisis line.","MEANS REDUCTION: Identify anything at home that could be dangerous; plan to reduce access.","Keep this saved on your phone's home screen or printed somewhere accessible."],tips:"Build this when calmer \u2014 not during the crisis. Review it with someone you trust.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"How to Make a Personal Safety Plan (YouTube)"},{id:"Immediate_Professional_Help",name:"Seek Immediate Professional Help",parameters:["DEP"],goals:["Urgent connection to professional care"],score_ranges:{DEP:"20-27"},duration_minutes:0,frequency:"Now",description:"Severe depression requires immediate professional support. This is not a moment for self-help exercises alone.",research_basis:"PHQ-9 severe depression protocol; NICE crisis pathway",tutorial_steps:["Contact your doctor, therapist, or psychiatrist today \u2014 not this week, today.","If you don't have one: go to the nearest hospital or mental health center.","Tell them how long you've been feeling this way and how severe it is.","Bring a trusted person with you if possible.","You deserve and need this level of support right now."],tips:"Severe depression is a medical condition. Seeking help is the most important thing you can do today.",video_url:"https://www.youtube.com/watch?v=MIr3RsUWrdo",video_title:"When to Seek Help for Depression (YouTube)"},{id:"Basic_Breathing_1xDay",name:"Daily Breathing Reset",parameters:["ANX","STR"],goals:["Daily anxiety maintenance","Build a calming baseline habit"],score_ranges:{ANX:"0-4"},duration_minutes:3,frequency:"Once daily",description:"A foundational breathing exercise that shifts from shallow chest breathing to deep diaphragmatic breathing. Even one daily session rewires the default stress response over time.",research_basis:"General anxiety maintenance; Harvard Medical School breathing research",tutorial_steps:["Sit or lie down. Place one hand on your chest, one on your belly.","Breathe IN through your nose for 4 counts \u2014 the belly hand should rise, not the chest hand.","Breathe OUT through pursed lips for 6 counts, gently pressing your belly in.","Do 5-10 slow breaths.","Notice the calm that settles in your shoulders and jaw."],tips:"If only your chest moves, you're not activating the diaphragm. Practice the belly rise first.",video_url:"https://www.youtube.com/watch?v=odADwWzHR24",video_title:"Diaphragmatic Breathing Tutorial (YouTube)"},{id:"Light_Journaling_3xWeek",name:"Light Journaling",parameters:["ANX","DEP"],goals:["Process worry through writing","Reduce mental load"],score_ranges:{ANX:"0-4"},duration_minutes:5,frequency:"3 times per week",description:"Regular brief journaling externalizes anxious thoughts \u2014 moving them from the mind onto paper where they can be observed rather than experienced.",research_basis:"Pennebaker expressive writing research; Anxiety self-monitoring",tutorial_steps:["Open a notebook or notes app. Set a timer for 5 minutes.","Write freely \u2014 whatever is on your mind. No editing, no structure required.","When the timer ends, close the journal.","Optional: before closing, write one sentence: 'What's one thing I can do today that's in my control?'"],tips:"Don't re-read what you wrote. The act of writing is what clears the mental queue.",video_url:"https://www.youtube.com/watch?v=WPPPFqsECz0",video_title:"Journaling for Anxiety Relief (YouTube)"},{id:"Routine_SelfCare_Checklist",name:"Daily Self-Care Checklist",parameters:["ANX","ENG"],goals:["Protect baseline wellbeing","Prevent anxiety from building"],score_ranges:{ANX:"0-4"},duration_minutes:5,frequency:"Daily review",description:"For minimal anxiety, the goal is protection \u2014 ensuring the basics that prevent anxiety from escalating are consistently in place.",research_basis:"Anxiety prevention; Lifestyle factors in GAD management",tutorial_steps:["Each morning or evening, check 5 basics: sleep (7-9h?), food (ate well?), movement (some today?), water (hydrated?), one positive interaction (had one?).","If any are missing, identify the easiest way to address it tomorrow.","This is a wellbeing foundation check \u2014 not a productivity tool."],tips:"Sleep, food, and movement are the three pillars that keep anxiety manageable. When all three slip, anxiety rises.",video_url:"https://www.youtube.com/watch?v=odADwWzHR24",video_title:"Daily Self-Care Habits for Anxiety (YouTube)"},{id:"Box_Breathing_3min",name:"Box Breathing",parameters:["ANX","STR"],goals:["Calm the nervous system quickly","Reduce anxiety in the moment"],score_ranges:{ANX:"5-9",STR:"5-9"},duration_minutes:3,frequency:"During stress spikes or 1-2x daily",description:"Used by Navy SEALs and validated in clinical anxiety research. Four equal counts of inhale, hold, exhale, hold activate the parasympathetic nervous system rapidly.",research_basis:"GAD-7 intervention; Sympathetic/parasympathetic regulation (Jerath et al., 2006)",tutorial_steps:["Sit comfortably and close your eyes if possible.","Breathe IN through your nose for 4 counts.","HOLD for 4 counts.","Breathe OUT through your mouth for 4 counts.","HOLD empty for 4 counts.","Repeat for 3-5 cycles. With each round, let your shoulders drop and body soften."],tips:"If 4 counts feels too long, start with 3. The hold phases activate the calming response most strongly.",video_url:"https://www.youtube.com/watch?v=tEmt1Znux58",video_title:"Box Breathing \u2014 Technique & Guided Practice (YouTube)"},{id:"5_Senses_Grounding",name:"5-4-3-2-1 Grounding",parameters:["ANX","STR"],goals:["Stop thought spirals","Return to the present moment"],score_ranges:{ANX:"5-9"},duration_minutes:3,frequency:"During anxiety spikes or as needed",description:"A research-backed mindfulness technique that pulls attention from anxious thoughts back into sensory experience. Effective for panic, dissociation, and thought spirals.",research_basis:"MBSR grounding protocols; CBT grounding (Najavits, 2002)",tutorial_steps:["Stop and take one slow breath.","Name 5 things you can SEE \u2014 be specific ('a blue plastic chair with a crack on the armrest').","Name 4 things you can FEEL physically \u2014 fabric texture, air temperature, feet on floor.","Name 3 things you can HEAR \u2014 distant sounds, near sounds, your own breathing.","Name 2 things you can SMELL (or imagine two smells you like).","Name 1 thing you can TASTE.","Take another slow breath. Has anxiety dropped at all?"],tips:"The more specific and vivid your observations, the better it works. The brain cannot process detailed sensory input AND anxious thoughts at the same time.",video_url:"https://www.youtube.com/watch?v=30VMIEmA114",video_title:"5-4-3-2-1 Grounding Technique (YouTube)"},{id:"Gradual_Exposure_Steps",name:"Gradual Exposure Ladder",parameters:["ANX"],goals:["Reduce avoidance","Face feared situations step by step"],score_ranges:{ANX:"5-9"},duration_minutes:20,frequency:"Weekly planning + daily small exposures",description:"Avoidance maintains and grows anxiety. Gradual exposure \u2014 systematically approaching feared situations from easiest to hardest \u2014 is the most effective anxiety treatment known.",research_basis:"Exposure therapy meta-analysis (Wolpe, 1958; Foa, 2011); CBT for phobias and social anxiety",tutorial_steps:["Identify the situation you most avoid because of anxiety.","Build a LADDER of 8-10 steps from least scary (2/10) to most scary (10/10).","Example for social anxiety: 1) Smile at neighbor \u2192 3) Eye contact with cashier \u2192 5) Brief conversation \u2192 7) Small gathering \u2192 9) Speak up in a group.","Start at step 1. Do it. Stay until anxiety drops by at least 50%.","Repeat step 1 until it produces little anxiety. Only then move to step 2.","NEVER escape during exposure \u2014 that resets the learning.","Record anxiety before and after each step."],tips:"Anxiety rising during exposure means it's working. Your willingness to feel discomfort IS the therapy. The anxiety will pass.",video_url:"https://www.youtube.com/watch?v=dDXy1QKbCTE",video_title:"Exposure Therapy \u2014 How and Why It Works (YouTube)"},{id:"Worry_Scheduling_15min",name:"Worry Time Scheduling",parameters:["ANX"],goals:["Contain worry to a defined window","Reduce all-day anxiety"],score_ranges:{ANX:"10-14"},duration_minutes:15,frequency:"Daily at the same time",description:"Instead of trying to stop worrying, you schedule a specific 15-minute daily worry window. When worries arise outside it, you postpone them. This breaks the habit of constant background worry.",research_basis:"Borkovec et al. (1983) worry postponement study; GAD treatment protocols",tutorial_steps:["Choose a worry time each day (e.g., 5:00-5:15 PM). NOT near bedtime.","When a worry arises outside this window, write it on a list: 'I'll think about this at 5 PM.'","At your worry window: actively think through each worry and problem-solve if you can.","After 15 minutes, close the list. Worry time is over.","If you catch yourself worrying outside the window: 'That's on my list for 5 PM.'","After one week: are your worries as urgent at 5 PM as they felt in the moment?"],tips:"You're not suppressing worry \u2014 you're managing it. The brain learns that worries can wait.",video_url:"https://www.youtube.com/watch?v=haS_4mFZgxs",video_title:"Worry Time \u2014 How to Stop Constant Worrying (YouTube)"},{id:"Sleep_Hygiene_Checklist",name:"Sleep Hygiene Checklist",parameters:["ANX","SLP"],goals:["Improve anxiety-disrupted sleep","Build consistent sleep routine"],score_ranges:{ANX:"10-14"},duration_minutes:0,frequency:"Every night",description:"Anxiety and poor sleep fuel each other. This checklist applies CBT-I (gold standard for insomnia) principles to break the cycle.",research_basis:"CBT-I (Morin et al.); AASM Sleep Guidelines; ISI clinical protocols",tutorial_steps:["Fixed wake time: same time every day \u2014 including weekends. Most important rule.","No screens 45 minutes before bed \u2014 blue light delays melatonin by 2 hours.","Bed = sleep only: no work, worry, or scrolling in bed.","Cool room: 16-19\xb0C (60-67\xb0F) helps trigger sleep onset.","Pre-sleep wind-down: 20 minutes of something calm before bed.","If awake 20+ minutes: get up, calm activity in dim light, return when sleepy."],tips:"Start with just ONE rule this week \u2014 the most broken one. Fix it first.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"Sleep Hygiene for Anxiety (YouTube)"},{id:"Panic_Response_Steps",name:"Panic Response Plan",parameters:["ANX"],goals:["Manage panic attacks effectively","Reduce fear of panic"],score_ranges:{ANX:"15-21"},duration_minutes:5,frequency:"During panic \u2014 have it memorized",description:"A clear step-by-step protocol for surviving a panic attack. Having a written plan transforms panic from an uncontrollable crisis into a manageable sequence.",research_basis:"Panic Disorder CBT protocol (Clark, 1986)",tutorial_steps:["STEP 1: Say to yourself: 'This is a panic attack. I am not in danger. It will peak in about 10 minutes and pass.'","STEP 2: Breathe IN for 5 counts, OUT for 5 counts. Repeat 10 times.","STEP 3: Plant both feet flat on the floor. Press them down firmly.","STEP 4: Name 5 things you can see around you right now.","STEP 5: Stay where you are if safe \u2014 leaving reinforces avoidance.","STEP 6: After it passes, write what triggered it if you know.","Save this as your phone lock screen so it's always accessible."],tips:"Read this plan several times when CALM so your brain knows it by heart when panic hits.",video_url:"https://www.youtube.com/watch?v=vXZ5l7G6T2I",video_title:"What to Do During a Panic Attack (YouTube)"},{id:"Problem_Solving_Worksheet",name:"Structured Problem Solving",parameters:["ANX","STR"],goals:["Reduce anxiety from unresolved problems","Build confidence in handling challenges"],score_ranges:{ANX:"15-21"},duration_minutes:15,frequency:"As needed for specific worries",description:"Many anxiety spirals center on real problems that feel unsolvable. Structured problem solving breaks them into manageable steps, reducing helplessness.",research_basis:"Problem-Solving Therapy (PST); D'Zurilla & Goldfried (1971); CBT for GAD",tutorial_steps:["Write the problem clearly in one sentence.","Brainstorm 5-8 possible solutions \u2014 no evaluation yet. Include even imperfect ones.","For each solution, rate pros and cons briefly.","Choose the best available option \u2014 not perfect, just best available.","Write the first concrete step with a specific time.","Do that step. Reassess after."],tips:"Anxiety turns solvable problems into catastrophes. Writing them down and treating them as problems to solve changes everything.",video_url:"https://www.youtube.com/watch?v=hnpQrMqDoqE",video_title:"Structured Problem Solving for Anxiety (YouTube)"}]},520,[]);
__d(function(e,t,i,n,o,s,a){o.exports=[{id:"Simple_Breathing_1xDay",name:"Simple Daily Breathing",parameters:["STR"],goals:["Minimal stress maintenance","Build a daily calming habit"],score_ranges:{STR:"0-4"},duration_minutes:3,frequency:"Once daily",description:"A single daily breathing reset is enough to maintain a calm baseline and prevent stress from gradually building up.",research_basis:"PSS stress maintenance; Preventive stress management",tutorial_steps:["At a consistent time each day (morning coffee, lunch, before bed), take 5 slow deep belly breaths.","IN for 4 counts, OUT for 6 counts.","2-3 minutes total."],tips:"Attaching this to an existing habit (coffee, commute, brushing teeth) ensures it actually happens.",video_url:"https://www.youtube.com/watch?v=odADwWzHR24",video_title:"Simple Breathing for Stress (YouTube)"},{id:"Hobby_Time_Weekly",name:"Weekly Hobby Time",parameters:["STR","DEP"],goals:["Maintain stress-relief outlets","Protect non-work time"],score_ranges:{STR:"0-4"},duration_minutes:30,frequency:"Once per week minimum",description:"Low stress is best maintained by protecting time for activities that provide genuine enjoyment and psychological distance from responsibilities.",research_basis:"Stress inoculation maintenance; Positive psychology leisure research",tutorial_steps:["Identify one hobby or enjoyable activity you've been neglecting.","Schedule 30-60 minutes for it this week and put it in your calendar.","Protect this time like a meeting you can't cancel.","During the activity: be present \u2014 not thinking about your to-do list."],tips:"Leisure is not a reward for finishing work. It's a requirement for sustainable performance.",video_url:"https://www.youtube.com/watch?v=hnpQrMqDoqE",video_title:"Why Hobbies Are Essential for Stress (YouTube)"},{id:"Routine_Breaks",name:"Scheduled Micro-Breaks",parameters:["STR"],goals:["Prevent stress accumulation","Maintain focus and energy"],score_ranges:{STR:"0-4"},duration_minutes:5,frequency:"Every 90 minutes during work",description:"The brain works in 90-minute ultradian cycles. Taking 5-minute breaks at these natural intervals prevents stress from building and maintains cognitive performance.",research_basis:"Ultradian rhythm research; Stress and recovery cycles (Peretz Lavie)",tutorial_steps:["Set a recurring alarm for every 90 minutes during your work day.","When it goes off: stop, stand up, step away from your screen.","For 5 minutes: walk around, stretch, look out a window, make tea \u2014 anything non-screen.","Return to work."],tips:"These breaks feel like a waste of time \u2014 they're not. They prevent the exhaustion that costs you 2 hours at the end of the day.",video_url:"https://www.youtube.com/watch?v=hnpQrMqDoqE",video_title:"The Science of Taking Breaks (YouTube)"},{id:"Box_Breathing_5min_Breaks",name:"Box Breathing During Stress Breaks",parameters:["STR"],goals:["Reduce mid-day stress accumulation","Reset nervous system between tasks"],score_ranges:{STR:"5-9"},duration_minutes:5,frequency:"2-3 times during the work day",description:"Using Box Breathing during scheduled breaks transforms passive rest into active stress reduction, significantly lowering cumulative daily stress.",research_basis:"PSS mild stress intervention; Sympathetic regulation during work stress",tutorial_steps:["During any break, sit quietly and close your eyes.","Breathe IN for 4 counts, HOLD for 4, OUT for 4, HOLD for 4.","Repeat for 5-6 cycles (about 2 minutes).","Before returning to work: set one clear intention for the next 90 minutes."],tips:"Even one round of box breathing during a stressful moment measurably reduces cortisol.",video_url:"https://www.youtube.com/watch?v=tEmt1Znux58",video_title:"Box Breathing for Work Stress (YouTube)"},{id:"Time_Blocking_Schedule",name:"Time Blocking",parameters:["STR"],goals:["Reduce overwhelm from too many tasks","Build structure around work"],score_ranges:{STR:"5-9"},duration_minutes:15,frequency:"Once per day (morning planning)",description:"Unstructured task lists increase stress because the brain constantly scans an open-ended threat. Assigning tasks to specific time blocks transforms an overwhelming list into a manageable schedule.",research_basis:"Time management and PSS scores; Cognitive load reduction research",tutorial_steps:["Each morning, take 10-15 minutes to review what needs to happen today.","Assign each task to a specific time block \u2014 not a list, but an actual calendar slot.","Include breaks in your blocking (e.g., 9-10:30 deep work, 10:30-10:45 break).","Be realistic \u2014 most people can do only 3-4 hours of deep work per day.","At end of day: what got done? Update tomorrow's blocks."],tips:"The plan will change. That's okay. Having a plan and adapting it is far less stressful than having no plan.",video_url:"https://www.youtube.com/watch?v=hnpQrMqDoqE",video_title:"Time Blocking \u2014 How to Manage Your Day (YouTube)"},{id:"One_Enjoyable_Activity_Daily",name:"One Enjoyable Activity Daily",parameters:["STR","DEP"],goals:["Maintain wellbeing buffer against stress","Prevent burnout"],score_ranges:{STR:"5-9"},duration_minutes:15,frequency:"Daily",description:"When under mild stress, people typically drop enjoyable activities first \u2014 creating a wellbeing deficit. Protecting one daily enjoyable activity maintains the stress buffer.",research_basis:"Stress inoculation; Burnout prevention; Positive ratio (Fredrickson, 2001)",tutorial_steps:["Each day, protect 15 minutes for something genuinely enjoyable \u2014 not productive, just enjoyable.","Examples: music, a walk, gaming, cooking something you like, reading for pleasure.","Schedule it at a specific time. Treat it as non-negotiable.","During it: actually be present."],tips:"This is not self-indulgent. It is stress inoculation. People who burn out are the ones who drop enjoyment entirely.",video_url:"https://www.youtube.com/watch?v=hnpQrMqDoqE",video_title:"Preventing Burnout \u2014 The Role of Enjoyment (YouTube)"},{id:"Stress_Log_Tracking",name:"Stress Trigger Log",parameters:["STR"],goals:["Identify stress patterns","Enable targeted coping strategies"],score_ranges:{STR:"10-14"},duration_minutes:5,frequency:"Daily for 2 weeks",description:"Tracking when and why stress spikes occur reveals patterns invisible in the moment. Once patterns are identified, targeted interventions replace generic coping.",research_basis:"Stress Inoculation Training (Meichenbaum, 1977); PSS clinical intervention",tutorial_steps:["Each time stress spikes, write: Time, Situation, Stress 1-10, Physical sensation, Thought.","At end of each day: spend 2 minutes reviewing entries.","After one week: look for patterns \u2014 same times? Same people? Same situations?","Identify your top 2 stress triggers.","For each trigger: brainstorm one thing you could change or prepare."],tips:"Stressed people often believe 'everything' causes stress. The log usually reveals it's 2-3 specific things.",video_url:"https://www.youtube.com/watch?v=hnpQrMqDoqE",video_title:"Understanding Your Stress Triggers (YouTube)"},{id:"Task_Breakdown_Planning",name:"Task Breakdown \u2014 Micro Steps",parameters:["STR","ANX","DEP"],goals:["Reduce overwhelm from large tasks","Enable action despite high stress"],score_ranges:{STR:"10-14"},duration_minutes:10,frequency:"Weekly, then as needed",description:"Overwhelming tasks trigger avoidance, which creates more stress. Breaking any task into tiny specific micro-steps eliminates the activation barrier.",research_basis:"Implementation intention research (Gollwitzer, 1999); CBT for procrastination and stress",tutorial_steps:["Write down the task that feels most overwhelming.","Ask: 'What is the absolute smallest first step?' (Not 'write the report' \u2014 but 'open a doc and type the title')","List 5 micro-steps from start to a defined stopping point.","Schedule step 1 with a specific time \u2014 max 15 minutes.","After step 1: celebrate it. Then assess: do step 2 now or later?"],tips:"Each step should feel almost too easy. That is intentional \u2014 it bypasses the brain's resistance to starting.",video_url:"https://www.youtube.com/watch?v=hnpQrMqDoqE",video_title:"How to Break Tasks Down Under Stress (YouTube)"},{id:"Daily_Wind_Down_Routine",name:"Evening Wind-Down Routine",parameters:["STR","SLP"],goals:["Decompress from daily stress","Separate work from rest"],score_ranges:{STR:"10-14"},duration_minutes:20,frequency:"Every evening",description:"Moderate stress leaves the nervous system activated well into the evening, impairing sleep and recovery. A structured wind-down routine signals the end of the stress period.",research_basis:"Stress recovery research (Sonnentag & Fritz, 2007); CBT-I wind-down protocols",tutorial_steps:["T-20 min: Dim all lights. Stop work-related activity completely.","T-15 min: Brain dump \u2014 write everything still on your mind for tomorrow.","T-10 min: Gentle stretching or light breathing (5 minutes).","T-5 min: Sit quietly with tea, calm music, or light reading.","Bedtime: 4-7-8 breathing for 2-3 cycles.","Keep this routine identical every night \u2014 consistency is what makes it work."],tips:"Without a wind-down routine, under moderate stress your body stays in 'work mode' for hours after you stop working.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"Evening Routine for Stress Recovery (YouTube)"},{id:"Crisis_Task_List",name:"Crisis Priority List",parameters:["STR"],goals:["Triage overwhelming tasks urgently","Restore sense of control"],score_ranges:{STR:"15-21"},duration_minutes:15,frequency:"Immediately, then daily",description:"Under high stress overload, the first step is emergency triage \u2014 separating what MUST happen from everything else.",research_basis:"Crisis management; Stress Inoculation Training high-stress protocol",tutorial_steps:["Write every task and responsibility currently stressing you.","Mark each: CRITICAL / IMPORTANT / CAN WAIT / DELEGATE OR DROP.","Focus ONLY on CRITICAL items for the next 24 hours.","For each CRITICAL item: identify the single next action.","Do those actions only. Review the list tomorrow."],tips:"At maximum stress, doing 3 critical things is better than attempting 15 everything.",video_url:"https://www.youtube.com/watch?v=hnpQrMqDoqE",video_title:"How to Prioritize Under Extreme Stress (YouTube)"},{id:"Delegation_Planning",name:"Delegation & Boundary Setting",parameters:["STR"],goals:["Reduce overload by redistributing responsibilities","Practice saying no"],score_ranges:{STR:"15-21"},duration_minutes:15,frequency:"Once urgently, then ongoing",description:"High stress overload is often partly maintained by taking on responsibilities that can be delegated or declined.",research_basis:"PSS high-stress clinical protocols; Assertiveness and stress research",tutorial_steps:["From your task list: identify 2-3 things someone else could do.","Identify 1-2 commitments you need to decline or postpone.","For each delegation: identify who, and draft a clear direct ask.","For each boundary: decide what to say and say it \u2014 'I can't take this on right now.'","This may feel uncomfortable. Do it anyway \u2014 your wellbeing depends on it."],tips:"Delegation and boundaries are not failures \u2014 they're survival.",video_url:"https://www.youtube.com/watch?v=hnpQrMqDoqE",video_title:"How to Delegate and Set Limits Under Stress (YouTube)"},{id:"Professional_Support_Info",name:"Finding Professional Stress Support",parameters:["STR"],goals:["Connect to professional support for severe stress"],score_ranges:{STR:"15-21"},duration_minutes:10,frequency:"One-time action",description:"High stress overload that is persistent and unsustainable warrants professional support.",research_basis:"Stress Inoculation Training professional referral; PSS high score protocols",tutorial_steps:["Search for a therapist or counselor who specializes in stress or burnout.","Ask your doctor, HR, or check your insurance for referrals.","Look for professionals trained in CBT, ACT, or Stress Inoculation Training.","Make one contact today.","If cost is a barrier: check community mental health centers or online therapy platforms."],tips:"Chronic high stress is a medical concern. Seeking help for it is as reasonable as seeing a doctor for physical pain.",video_url:"https://www.youtube.com/watch?v=MIr3RsUWrdo",video_title:"When to Seek Help for Stress and Burnout (YouTube)"},{id:"Maintain_Sleep_Schedule",name:"Maintain Sleep Schedule",parameters:["SLP"],goals:["Protect healthy sleep","Prevent circadian drift"],score_ranges:{SLP:"0-2"},duration_minutes:0,frequency:"Every day",description:"Good sleep is maintained primarily through consistency. Protecting wake and sleep times keeps the circadian clock calibrated.",research_basis:"Circadian biology; PSQI maintenance; CBT-I prevention",tutorial_steps:["Keep your wake time within 30 minutes every day \u2014 including weekends.","Keep your bedtime within 30 minutes every day.","If you sleep in on weekends, do it by no more than 1 hour.","This is the single most impactful sleep habit to protect."],tips:"Social jet lag (large weekend/weekday differences) is as harmful to energy as mild insomnia.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"Sleep Schedule \u2014 Why Consistency Matters (YouTube)"},{id:"Light_Daily_Movement",name:"Light Daily Movement",parameters:["SLP","DEP"],goals:["Improve sleep quality through physical activity"],score_ranges:{SLP:"0-2"},duration_minutes:20,frequency:"Daily",description:"Regular light movement significantly improves sleep quality. Consistency matters more than intensity.",research_basis:"Exercise and sleep quality meta-analysis; PSQI physical activity correlation",tutorial_steps:["Aim for 20-30 minutes of light movement daily \u2014 a walk, bike ride, or light workout.","Morning or afternoon is ideal \u2014 avoid vigorous exercise within 2 hours of bedtime.","Even 10-minute walks count.","Outdoor movement adds natural light exposure for circadian regulation."],tips:"Even people who feel 'too tired to exercise' sleep better when they add light movement.",video_url:"https://www.youtube.com/watch?v=WDv4AWk0J3U",video_title:"Exercise and Sleep \u2014 The Connection (YouTube)"},{id:"Evening_Routine_Check",name:"Evening Routine Check",parameters:["SLP"],goals:["Maintain protective sleep habits","Prevent gradual sleep degradation"],score_ranges:{SLP:"0-2"},duration_minutes:5,frequency:"Every evening",description:"For good sleepers, a brief nightly check ensures protective habits stay in place.",research_basis:"CBT-I sleep maintenance protocols",tutorial_steps:["Each evening, do a quick 5-point check: screens off? Room cool and dark? Bedtime consistent? No caffeine after 2 PM? 10 min of something calming?","Fix any 'no' for tomorrow.","That's it."],tips:"Good sleep hygiene erodes gradually \u2014 people stop noticing until quality is significantly worse.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"Evening Routine for Better Sleep (YouTube)"},{id:"Sleep_Hygiene_Basics",name:"Sleep Hygiene Basics",parameters:["SLP","ANX"],goals:["Build a consistent sleep foundation","Improve mild sleep problems"],score_ranges:{SLP:"3-5"},duration_minutes:0,frequency:"Nightly habits",description:"The core CBT-I sleep hygiene rules. The most evidence-based non-medication approach to improving sleep.",research_basis:"CBT-I (Morin et al.); AASM Sleep Hygiene Guidelines; ISI clinical protocols",tutorial_steps:["FIXED SCHEDULE: Same bedtime and wake time every day, including weekends.","BED = SLEEP ONLY: No work, eating, or screens in bed.","SCREENS OFF: No phone or laptop 45 minutes before bed.","COOL ROOM: 16-19\xb0C / 60-67\xb0F.","DARK ROOM: Blackout curtains or sleep mask.","CAFFEINE CUTOFF: Nothing caffeinated after 2 PM.","IF AWAKE 20+ MINUTES: Get up, calm activity in dim light, return when sleepy."],tips:"Start with just ONE rule this week \u2014 the one you most consistently break.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"Sleep Hygiene \u2014 CBT-I Basics (YouTube)"},{id:"Screen_Cutoff_Rule",name:"Screen Cutoff Rule",parameters:["SLP"],goals:["Protect melatonin production","Improve sleep onset"],score_ranges:{SLP:"3-5"},duration_minutes:0,frequency:"Every night",description:"Blue light from screens delays melatonin onset by up to 2 hours. One of the highest-impact free sleep interventions.",research_basis:"Harvard Medical School (Chang et al., 2015); Sleep Medicine Reviews",tutorial_steps:["Set an alarm labeled 'SCREENS OFF' for 45 minutes before your bedtime.","When it goes off: put your phone in another room.","Use those 45 minutes for light reading, journaling, stretching, or quiet music.","Track sleep quality for 5 days \u2014 most people notice results within 3-5 nights."],tips:"The dopamine loop of social media is also a problem \u2014 not just the blue light.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"How Blue Light Affects Your Sleep (YouTube)"},{id:"Morning_Light_Exposure",name:"Morning Light Exposure",parameters:["SLP","DEP"],goals:["Reset circadian rhythm","Improve sleep quality and mood"],score_ranges:{SLP:"3-5"},duration_minutes:10,frequency:"Every morning",description:"Bright natural light in the first 30 minutes of waking is the most powerful circadian clock signal. It also acts as a natural antidepressant with effect sizes comparable to medication.",research_basis:"Circadian biology (Czeisler); Light therapy for depression (Terman, 2012); Huberman Lab",tutorial_steps:["Within 30 minutes of waking: go outside or sit by a window with direct light.","Get 10 minutes of natural light on your face \u2014 no sunglasses if safe.","Overcast days still count \u2014 outdoor overcast light is brighter than indoor light.","Combine with something pleasant: coffee, a short walk, quiet time."],tips:"Free, 10 minutes, improves both sleep and mood, backed by decades of circadian research. One of the highest-ROI health habits available.",video_url:"https://www.youtube.com/watch?v=WDv4AWk0J3U",video_title:"Morning Sunlight for Sleep & Mood \u2014 Dr. Huberman (YouTube)"},{id:"Sleep_Schedule_Builder",name:"Sleep Schedule Builder",parameters:["SLP"],goals:["Rebuild consistent sleep timing","Address moderate insomnia"],score_ranges:{SLP:"6-8"},duration_minutes:10,frequency:"Daily for 3 weeks",description:"A core CBT-I technique. Choosing fixed sleep/wake times and adhering to them strictly for 3 weeks rebuilds the circadian signal.",research_basis:"CBT-I sleep restriction and scheduling (Morin, 1993); Stimulus control therapy",tutorial_steps:["Choose a wake time you can commit to 7 days a week (e.g., 7:00 AM).","Count back 7.5-8 hours for your target bedtime (e.g., 11:00 PM).","Week 1: only go to bed when genuinely sleepy AND past your target bedtime.","Wake at your fixed time NO MATTER WHAT \u2014 even after a bad night.","No naps longer than 20 minutes during this phase.","After 2 weeks of consistency: assess and adjust if needed."],tips:"The first 2-3 days may feel harder. That's normal \u2014 you're building sleep pressure. It gets significantly better by week 2.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"CBT-I Sleep Schedule Rebuilding (YouTube)"},{id:"Caffeine_Tracking",name:"Caffeine Audit & Tracking",parameters:["SLP"],goals:["Identify caffeine's impact on sleep","Reduce sleep-disrupting caffeine patterns"],score_ranges:{SLP:"6-8"},duration_minutes:5,frequency:"Daily for one week",description:"Caffeine has a 5-6 hour half-life. A 3 PM coffee still has 50% active at 9 PM. Many people don't realize their sleep problems are caffeine-driven.",research_basis:"Caffeine metabolism research; PSQI caffeine correlation",tutorial_steps:["For one week, log every caffeinated item: time, what, how much.","Includes: coffee, tea, energy drinks, pre-workout, some medications.","Identify your last caffeine intake each day and the time you had trouble sleeping.","Move your caffeine cutoff earlier by 1 hour and observe for 3 days.","Target: no caffeine after 1-2 PM for most people."],tips:"Caffeine sensitivity varies widely. Track to find YOUR personal cutoff.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"Caffeine and Sleep \u2014 What You Need to Know (YouTube)"},{id:"Pre_Sleep_Wind_Down",name:"Pre-Sleep Wind-Down Routine",parameters:["SLP","STR"],goals:["Signal the brain sleep is coming","Decompress before bed"],score_ranges:{SLP:"6-8"},duration_minutes:20,frequency:"Every night",description:"The brain needs 20-30 minutes to downshift from waking alertness to sleep. This structured routine creates consistent signals that sleep is coming.",research_basis:"CBT-I sleep onset protocol; Sleep onset latency research",tutorial_steps:["T-20 min: Dim all lights.","T-15 min: Brain dump \u2014 write tomorrow's to-do list and any lingering thoughts.","T-10 min: Light stretching or 5-minute PMR.","T-5 min: Sit in bed with a physical book or just quiet.","Lying down: 4-7-8 breathing for 2-3 cycles.","Keep the routine identical every night \u2014 the ritual becomes the sleep cue."],tips:"Think of it like a baby's bedtime routine \u2014 the sequence itself becomes the signal for sleep.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"Build a Wind-Down Routine for Better Sleep (YouTube)"},{id:"Sleep_Tracking_Log",name:"Sleep Tracking Log",parameters:["SLP"],goals:["Identify sleep disruption patterns","Enable evidence-based improvement"],score_ranges:{SLP:"9-10"},duration_minutes:5,frequency:"Every morning for 2 weeks",description:"For severe sleep problems, tracking provides the data needed to identify what's disrupting sleep. Used as a standard tool in CBT-I clinical programs.",research_basis:"CBT-I sleep diary (Morin, 1993); ISI tracking protocols",tutorial_steps:["Every morning within 15 minutes of waking, log: bedtime, estimated sleep onset time, number of awakenings, final wake time, total sleep estimate, mood/energy on waking (1-10).","Don't check the clock at night \u2014 estimates only. Clock-watching worsens insomnia.","After 2 weeks: review for your 2-3 biggest disruptors.","Use the log to track change as you implement sleep interventions."],tips:"Estimates are fine. The patterns across 14 days reveal what the brain can't notice night to night.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"How to Use a Sleep Diary (YouTube)"},{id:"Sleep_Recovery_Plan",name:"Sleep Recovery Plan",parameters:["SLP"],goals:["Structured recovery from severe insomnia or fatigue"],score_ranges:{SLP:"9-10"},duration_minutes:15,frequency:"Design once, implement over 3-4 weeks",description:"A structured multi-week plan combining all evidence-based sleep interventions for severe sleep problems. CBT-I has a 70-80% success rate for chronic insomnia.",research_basis:"CBT-I full protocol (Morin, 1993; Harvey, 2007); ISI severe remission pathway",tutorial_steps:["WEEK 1: Fix wake time only. Wake at the same time every day no matter what.","WEEK 2: Add caffeine cutoff (1-2 PM) and screen cutoff (45 min before bed).","WEEK 3: Add pre-sleep wind-down routine and bedroom environment improvements.","WEEK 4: Add stimulus control \u2014 bed for sleep only; get up if awake 20+ minutes.","Throughout: keep sleep tracking log. Review weekly.","After 4 weeks: assess with a healthcare provider if severe symptoms persist."],tips:"CBT-I has better long-term outcomes than sleep medication. Give it 4 weeks.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"CBT-I \u2014 The Complete Sleep Recovery Protocol (YouTube)"},{id:"Medical_Referral",name:"Medical Sleep Evaluation",parameters:["SLP"],goals:["Rule out medical causes of severe sleep problems"],score_ranges:{SLP:"9-10"},duration_minutes:0,frequency:"One-time action",description:"Severe sleep problems may have underlying medical causes (sleep apnea, restless legs, thyroid) that behavioral interventions alone cannot address.",research_basis:"Sleep medicine clinical guidelines; AASM referral criteria",tutorial_steps:["Contact your doctor and describe your sleep symptoms: how long, what type (can't fall asleep / wake frequently / never feel rested).","Ask specifically about a sleep study if you snore heavily, wake gasping, or feel exhausted despite adequate time in bed.","Also ask about thyroid function and iron levels \u2014 both affect sleep quality.","Bring your sleep tracking log if you have one."],tips:"Sleep apnea affects roughly 1 in 5 adults and is significantly underdiagnosed. If you snore and feel unrefreshed, ask specifically about it.",video_url:"https://www.youtube.com/watch?v=nm1TxQj9IsQ",video_title:"When to See a Doctor for Sleep Problems (YouTube)"},{id:"Contact_One_Trusted_Person",name:"Contact One Trusted Person",parameters:["SOC"],goals:["Break severe isolation immediately"],score_ranges:{SOC:"0-2"},duration_minutes:5,frequency:"Today, then daily",description:"Severe loneliness requires immediate action. This exercise identifies and activates even one existing support connection as a first step out of isolation.",research_basis:"UCLA Loneliness Scale interventions; Crisis social support research",tutorial_steps:["Think of the ONE person in your life you trust most \u2014 even if you haven't spoken in a while.","Contact them today: 'Hey, I've been having a hard time. Can we talk?'","You don't have to explain everything. Just opening a line of contact is the first step.","If there is truly no one: contact a support line (findahelpline.com).","Notice how it felt vs. the isolation of not contacting."],tips:"Severe loneliness tells you no one cares. This is the loneliness talking, not reality. Test it.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Breaking Isolation \u2014 How to Reach Out (YouTube)"},{id:"Online_Support_Groups",name:"Online Support Groups",parameters:["SOC"],goals:["Find community when local connection is difficult"],score_ranges:{SOC:"0-2"},duration_minutes:15,frequency:"Several times per week",description:"When in-person social connection is unavailable, online communities provide genuine belonging and understanding that directly reduces loneliness.",research_basis:"Online social support and loneliness research; UCLA Loneliness Scale digital interventions",tutorial_steps:["Identify one area of interest, challenge, or experience you have.","Search for online communities: Reddit, Discord, Facebook Groups, topic-specific forums.","Start by reading \u2014 you don't have to post right away.","When ready: make one comment or introduction post.","Engage 3-4 times per week for 2 weeks and assess how it feels."],tips:"Choose communities that feel supportive, not ones that amplify distress. Quality matters more than quantity.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Finding Community Online for Mental Health (YouTube)"},{id:"Crisis_Line_Info",name:"Crisis Support Line",parameters:["SOC","SAFE"],goals:["Immediate human contact for isolation or crisis"],score_ranges:{SOC:"0-2",SAFE:"6-8"},duration_minutes:0,frequency:"As needed",description:"When severely alone or in emotional crisis, crisis lines provide immediate human connection with trained listeners \u2014 confidential and free.",research_basis:"Crisis intervention; Social support emergency protocols",tutorial_steps:["Egypt: 08008880700 (mental health support line).","International directory: findahelpline.com","Text-based options exist if calling feels too hard.","You don't need to be suicidal to call \u2014 severe loneliness and distress are valid reasons.","They are trained to listen without judgment."],tips:"'I feel very alone and just need to talk to someone' is a completely valid reason to call.",video_url:"https://www.youtube.com/watch?v=3SHLnE5HHLE",video_title:"How to Use a Support Helpline (YouTube)"},{id:"Text_One_Friend_This_Week",name:"Text One Friend This Week",parameters:["SOC"],goals:["Reactivate social connections","Reduce moderate isolation"],score_ranges:{SOC:"3-5"},duration_minutes:3,frequency:"Once this week, then build",description:"Moderate loneliness is reduced most effectively by small, low-barrier social actions. Texting one person is the minimum viable social act.",research_basis:"UCLA Loneliness Scale; Behavioral Activation social component",tutorial_steps:["Think of one friend or acquaintance you'd like to reconnect with.","Send one text: 'Hey, I was thinking about you. How are you doing?'","No need for a long conversation.","If they reply: respond. If not: try someone else next time.","Did you feel slightly less alone after sending it?"],tips:"A 3-sentence exchange still counts as social contact.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Small Steps to Reduce Loneliness (YouTube)"},{id:"Online_Community_Join",name:"Join an Online Community",parameters:["SOC"],goals:["Find shared interests and reduce isolation"],score_ranges:{SOC:"3-5"},duration_minutes:20,frequency:"Weekly participation",description:"Finding a community around a shared interest provides social belonging without the pressure of one-on-one interaction.",research_basis:"Social belonging research; Online community and loneliness (Cacioppo, 2008)",tutorial_steps:["Think of any interest, hobby, or experience that defines you.","Search for an online community around it (Reddit, Discord, Facebook Groups, forums).","Join and browse for a week before participating.","Make one comment or question \u2014 keep it genuine.","Return weekly and gradually become a regular presence."],tips:"Shared interest communities feel less vulnerable than general social spaces.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Building Connection Through Shared Interests (YouTube)"},{id:"Interest_Group_Search",name:"Find a Local or Online Interest Group",parameters:["SOC"],goals:["Build new social connections through shared activities"],score_ranges:{SOC:"3-5"},duration_minutes:20,frequency:"Attend once, then regularly",description:"Structured group activities around shared interests provide natural social connection without the pressure of starting conversations from scratch.",research_basis:"Social activity and loneliness (UCLA scale); Community belonging research",tutorial_steps:["Identify one activity you enjoy or are curious about.","Search: Meetup.com, Facebook Events, local clubs, sports teams, volunteering organizations, or classes.","Commit to attending once. Tell yourself: I only have to try this once.","At the event: one small conversation is enough.","If it felt okay: go again. Repeated attendance builds familiarity, which builds connection."],tips:"You don't have to like everyone or feel instantly connected. Familiarity builds connection gradually.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Making New Friends as an Adult (YouTube)"},{id:"Maintain_Regular_Contact",name:"Maintain Regular Contact",parameters:["SOC"],goals:["Deepen existing connections","Prevent relationship drift"],score_ranges:{SOC:"6-8"},duration_minutes:10,frequency:"2-3 times per week",description:"Good social connections require consistent maintenance. Regular small check-ins keep relationships strong.",research_basis:"Relationship quality and mental health; UCLA Loneliness Scale healthy social practices",tutorial_steps:["Identify 3-5 people you value in your life.","Set a goal to have a brief meaningful contact with at least one every 2-3 days.","This can be: a text, a voice note, a call, something genuine.","Quality beats quantity. One specific thoughtful message matters more than five generic ones."],tips:"Strong relationships don't maintain themselves. They need regular small investments \u2014 just like plants need water.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"How to Maintain Strong Friendships (YouTube)"},{id:"Weekly_Social_Activity",name:"Weekly Social Activity",parameters:["SOC","DEP"],goals:["Regularly invest in social wellbeing","Build connection habits"],score_ranges:{SOC:"6-8"},duration_minutes:60,frequency:"Once per week",description:"People with good social support who maintain regular social activities have significantly better mental health outcomes.",research_basis:"Social activity and mental health; UCLA Loneliness Scale proactive practices",tutorial_steps:["Schedule one social activity per week \u2014 coffee, dinner, a sport, a walk, a shared activity.","Plan it in advance \u2014 spontaneous activities are great but unreliable.","Diversify across different relationships over time.","After each activity: what did you enjoy? Who do you want to see more?"],tips:"Consistent weekly social investment is one of the strongest predictors of long-term life satisfaction.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Social Connection and Mental Health (YouTube)"},{id:"Express_Gratitude",name:"Express Gratitude to Someone",parameters:["SOC","DEP"],goals:["Deepen bonds","Increase feelings of connection"],score_ranges:{SOC:"6-8"},duration_minutes:5,frequency:"Once per week",description:"Expressing specific appreciation to people in your life deepens bonds and increases wellbeing for both sender and receiver.",research_basis:"Seligman et al. (2005) gratitude expression; Social bond research; Positive psychology",tutorial_steps:["Think of someone who did something meaningful for you \u2014 recently or long ago.","Write or say specifically what they did AND how it affected you.","Format: 'When you [specific action], it made me feel [specific feeling]. It really mattered.'","Deliver it \u2014 text, call, or in person.","Notice both their reaction and yours."],tips:"Specific beats general. 'You're a great friend' is nice. 'When you called to check on me last month, it meant everything' \u2014 that's connection.",video_url:"https://www.youtube.com/watch?v=WPPPFqsECz0",video_title:"The Power of Expressing Gratitude (YouTube)"},{id:"Deepen_Connections",name:"Deepen Existing Connections",parameters:["SOC"],goals:["Move from surface-level to meaningful relationships"],score_ranges:{SOC:"9-10"},duration_minutes:30,frequency:"Monthly with key relationships",description:"Strong social support is most protective when relationships are deep, not just numerous.",research_basis:"Relationship depth and wellbeing; Intimacy research (Reis & Shaver, 1988)",tutorial_steps:["Identify 1-2 relationships you want to deepen.","Plan one deeper interaction: share something real about yourself, ask meaningful questions.","Good questions: 'What's something you're excited about?', 'What's been weighing on you?', 'What was the best moment of your week?'","Be willing to be vulnerable \u2014 depth requires reciprocal openness."],tips:"Consistent genuine interest and occasional real sharing are what build deep bonds.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"How to Have Deeper Conversations (YouTube)"},{id:"Reciprocal_Support",name:"Practice Reciprocal Support",parameters:["SOC"],goals:["Strengthen relationships through giving support"],score_ranges:{SOC:"9-10"},duration_minutes:15,frequency:"Ongoing",description:"Giving support to others has as large a wellbeing benefit as receiving it. Reciprocal relationships are more stable and more protective for mental health.",research_basis:"Giving and wellbeing research; Social support reciprocity",tutorial_steps:["Think of someone in your life who might be struggling right now.","Reach out with genuine support: 'I was thinking about you. How are you really doing?'","Listen fully \u2014 don't try to fix unless asked. Just listen.","Follow up in a few days.","Notice how giving support makes you feel."],tips:"People with strong support networks both give AND receive \u2014 it's not one-directional.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Giving Support \u2014 The Wellbeing Benefits (YouTube)"},{id:"Community_Involvement",name:"Community Involvement",parameters:["SOC"],goals:["Build sense of purpose and belonging through contributing to something larger"],score_ranges:{SOC:"9-10"},duration_minutes:60,frequency:"Monthly minimum",description:"Participation in community \u2014 volunteering, local groups, collective activities \u2014 provides one of the deepest forms of social belonging and purpose.",research_basis:"Community involvement and wellbeing; Purpose and mental health (Frankl; Ryff, 1989)",tutorial_steps:["Identify one cause, community, or group you care about.","Find a concrete way to participate: volunteer event, local club, community clean-up, advocacy organization.","Commit to attending once and assessing.","If it resonated: commit to regular participation.","Reflect: does contributing to something beyond yourself affect how you feel?"],tips:"Volunteering has one of the strongest evidence bases for wellbeing of any behavioral intervention.",video_url:"https://www.youtube.com/watch?v=_0QfQdpB60A",video_title:"Why Community Involvement Improves Mental Health (YouTube)"}]},521,[]);
